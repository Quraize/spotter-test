# Copy to .env and fill in. All values are read by config/settings.py via django-environ.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# sqlite:///db.sqlite3 by default. Any django-environ DATABASE_URL works.
# DATABASE_URL=sqlite:///db.sqlite3

# Routing response cache. Per-process LocMem by default; use Redis in multi-worker deployments.
# CACHE_URL=rediscache://127.0.0.1:6379/1

# External providers. Keep values free of inline comments: django-environ reads the whole line.
# Ordered fallback chains. Routing: ors, osrm. Geocoding: ors, nominatim.
ROUTING_PROVIDERS=ors,osrm
GEOCODING_PROVIDERS=ors,nominatim
# Free key from https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Truck profile by default; driving-car also works.
ORS_PROFILE=driving-hgv
# ORS_BASE_URL=https://api.openrouteservice.org
# OSRM_BASE_URL=https://router.project-osrm.org
# Nominatim rejects placeholder contacts (e.g. example.com) with 403. Use a real email or URL.
HTTP_USER_AGENT=spotter-fuel-router/0.1 (contact: you@yourdomain.com)
EXTERNAL_TIMEOUT_SECONDS=10
ROUTE_CACHE_SECONDS=86400
API_THROTTLE_RATE=60/min

# Production TLS hardening (leave off when a reverse proxy terminates TLS and sets headers)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
